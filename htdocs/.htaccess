# ============================================
# .htaccess - Sistema Multi-Emprendimiento
# Enruta las URLs de cada emprendimiento a su carpeta
# ============================================

RewriteEngine On
RewriteBase /

# Permitir acceso directo a archivos existentes
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# No enrutar si es la raíz o chatbot-api
RewriteRule ^chatbot-api\.php$ - [L]

# Enrutar a la plantilla base para cada emprendimiento dinámico
# Ejemplo: /mi-emprendimiento/productos.php -> /plantilla-base/productos.php?slug=mi-emprendimiento
RewriteRule ^([a-zA-Z0-9-]+)/(productos.php|producto-detalle.php|carrito.php|checkout.php|contacto.php|politicas.php|soporte.php|index.php)$ plantilla-base/$2?slug=$1 [L,QSA]

# Enrutar uploads de cada emprendimiento a su carpeta real
# Ejemplo: /mi-emprendimiento/uploads/imagen.jpg -> /mi-emprendimiento/uploads/imagen.jpg (archivo real)
# Esto ya funciona por la primera regla de archivos existentes

# Servir assets estáticos desde plantilla-base para cualquier slug
RewriteRule ^([a-zA-Z0-9-]+)/assets/(.*)$ plantilla-base/assets/$2 [L,QSA]

# Si solo es el slug sin archivo, redirigir a index.php
RewriteRule ^([a-zA-Z0-9-]+)$ plantilla-base/index.php?slug=$1 [L,QSA]

# Proteger directorios sensibles
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>

# Seguridad: ocultar firma del servidor
ServerSignature Off
Options -Indexes

# Compresión Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain application/json application/javascript image/svg+xml
</IfModule>

# Cache de navegador
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
